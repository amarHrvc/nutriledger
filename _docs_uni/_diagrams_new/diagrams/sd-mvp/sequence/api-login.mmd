sequenceDiagram
    actor User
    participant SPA as React SPA
    participant LR as LoginRequest
    participant AC as AuthController
    participant UM as User Model
    participant Sanctum

    User->>SPA: Enter email + password
    SPA->>LR: POST /api/login { email, password }
    LR->>LR: validate()

    alt Validation fails
        LR-->>SPA: 422 Unprocessable Entity
        SPA-->>User: Show field errors
    else Valid input
        LR->>AC: handle(request)
        AC->>UM: findByEmail + verifyPassword()

        alt Invalid credentials
            UM-->>AC: Authentication failed
            AC-->>SPA: 422 { errors: { email: [...] } }
            SPA-->>User: Show error message
        else Valid credentials
            UM-->>AC: User record
            AC->>Sanctum: createToken(user)
            Sanctum-->>AC: Opaque API token
            AC-->>SPA: 200 { data: UserResource + token }
            SPA->>SPA: Store token in AuthStore
            SPA-->>User: Redirect to dashboard
        end
    end
