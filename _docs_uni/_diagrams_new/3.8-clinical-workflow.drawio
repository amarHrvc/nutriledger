          <mxGeometry x="337" y="610" width="12" height="12" as="geometry"/>
        </mxCell>

        <mxCell id="note" value="High-level overview — detailed validation, authorization, queue, and API flows are shown in Figures 3.3–3.7." style="shape=note;whiteSpace=wrap;html=1;size=15;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#475569;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
