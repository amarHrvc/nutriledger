<mxfile host="app.diagrams.net" modified="2026-06-23T00:00:00.000Z" agent="Codex">
  <diagram name="Figure 3.8" id="activity-clinical-workflow">
    <mxGraphModel dx="2008" dy="1148" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Activity Diagram — Clinical Workflow" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="275" y="25" width="550" height="35" as="geometry"/>
        </mxCell>

        <mxCell id="start" value="" style="ellipse;html=1;aspect=fixed;fillColor=#1F2937;strokeColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="50" y="390" width="22" height="22" as="geometry"/>
        </mxCell>

        <mxCell id="phase1" value="1. Find or Register Patient&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Create the clinical and socioeconomic profile when needed&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontColor=#111827;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="105" y="335" width="150" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="patient-exists" value="Patient&lt;br&gt;already exists?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#111827;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="285" y="355" width="110" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="register" value="Register patient" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#111827;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="285" y="500" width="110" height="42" as="geometry"/>
        </mxCell>

        <mxCell id="phase2" value="2. Record Visit &amp; Vitals&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Document the clinical encounter and measurements&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontColor=#111827;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="335" width="150" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="phase3" value="3. Generate Diet Plan&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Use patient context to create an AI-assisted draft&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.5;fontColor=#111827;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="610" y="335" width="150" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="phase4" value="4. Clinical Review&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Doctor reviews, revises, and approves the plan&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontColor=#111827;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="790" y="335" width="150" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="phase5" value="5. Deliver Plan&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Send the approved diet plan to the patient&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontColor=#111827;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="790" y="555" width="150" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="phase6" value="6. Follow-Up&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Review progress and record the next clinical encounter&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontColor=#111827;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="610" y="555" width="150" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="followup-required" value="Further&lt;br&gt;follow-up?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#111827;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="445" y="570" width="120" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="end" value="" style="ellipse;html=1;aspect=fixed;fillColor=#FFFFFF;strokeColor=#1F2937;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="330" y="603" width="26" height="26" as="geometry"/>
        </mxCell>
