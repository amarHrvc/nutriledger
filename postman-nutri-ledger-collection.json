  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Collection-level pre-request script",
          "// Sets up environment if not already configured",
          "if (!pm.environment.get('base_url')) {",
          "    pm.environment.set('base_url', 'localhost:8000');",
          "}",
          "",
          "// Debug: Log current auth token status",
          "const token = pm.environment.get('admin_token');",
          "if (token) {",
          "    console.log('✓ Using token: ' + token.substring(0, 30) + '...');",
          "} else {",
          "    console.log('⚠️  admin_token not set - run Login first');",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "🔐 Authentication",
      "item": [
        {
          "name": "01 - Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Check response status",
                  "pm.test('Login successful (200)', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// Extract and store token",
                  "var jsonData = pm.response.json();",
                  "pm.test('Response contains token', function () {",
                  "    pm.expect(jsonData.data.token).to.exist;",
                  "});",
                  "",
                  "// Save token to environment",
                  "pm.environment.set('admin_token', jsonData.data.token);",
                  "pm.environment.set('admin_user_id', jsonData.data.user.id);",
                  "pm.environment.set('admin_email', jsonData.data.user.email);",
                  "",
                  "// Log for debugging",
                  "console.log('✓ Admin Token: ' + pm.environment.get('admin_token'));",
                  "console.log('✓ Admin ID: ' + pm.environment.get('admin_user_id'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@nutrilabs.com\",\n  \"password\": \"password\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/login",
              "protocol": "http",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
