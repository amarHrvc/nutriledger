includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 5
    paths:
        - app
        - routes
        - tests
    excludePaths:
        analyseAndScan:
            - app/Http/Middleware/TrustHosts.php (?)
            - app/Http/Middleware/TrustProxies.php (?)
    tmpDir: storage/phpstan
